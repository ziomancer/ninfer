# NInfer local engine — per-host config template.
# Copy to .env (gitignored) and fill in the three PER-HOST values below.
# Everything else has a sane default; the tuning values carry measured numbers
# from the original host (RTX 5090) as a starting point, not gospel.

# ── PER-HOST: must be set on every new machine ────────────────────────────────

# Loopback bearer token. Generate a fresh one per host; Hermes must send the
# same value. One-liner:
#   powershell: "ninfer-local-$((New-Guid).Guid -replace '-','')"
NINFER_API_KEY=

# Where the .ninfer artifacts live. Outside every repo, mirroring ~/.lmstudio/models.
# Default in docker-compose.yml is %USERPROFILE%/.ninfer/models — set this only
# to override. Forward slashes, no trailing slash.
#NINFER_MODELS_DIR=C:/Users/<you>/.ninfer/models

# Pin the GPU by UUID, not index — indices are not stable across reboots or PCIe
# reordering. Discover with:
#   nvidia-smi --query-gpu=uuid,name --format=csv,noheader
NINFER_GPU_DEVICE_ID=

# ── Artifact ──────────────────────────────────────────────────────────────────
# nvfp4 won the origin-host A/B (+9.7% over groupwise-int; 182.7 vs 166.5 tok/s)
# and both deployment targets are RTX 5090 boxes, so it is the default.
# qwen3_8_27b.ninfer (groupwise-int, 16.96 GiB, ~3 GiB more headroom) remains
# the fallback — switch with `.\VH-Model.ps1 artifact groupwise`.
NINFER_ARTIFACT=qwen3_8_27b_nvfp4.ninfer

# ── Serving shape ─────────────────────────────────────────────────────────────

# Host publish port. The container always serves 3400; Hermes' base_url must
# track this value.
NINFER_PORT=3400

# Per-request context limit. Input plus requested output count against it.
NINFER_MAX_CONTEXT=131072

# Device memory shared by KV and request state. This is the physical budget, separate
# from the logical limit above. Leave it explicit: `auto` plans up to the usable VRAM
# budget and removes the margin the embedders rely on. On first load, read the
# "context | device ..." log line and check that "KV ~N tokens" covers the limit above.
# Measured on the origin 5090 (int8): 6GiB estimates ~163k KV tokens and leaves
# 3.0-4.0 GiB free. `auto` took the pool to 9.75 GiB and left 687 MiB.
NINFER_CONTEXT_CAPACITY=6GiB

# How long a request may wait behind the active one before HTTP 503. A 32768-token
# generation takes about 3 minutes at concurrency 1, and the engine default of 30s
# expired real Hermes requests.
NINFER_PENDING_TIMEOUT=600s

# Concurrent request slots. KV tokens = concurrency × max-context. Hermes'
# workload is serialized; 1 is correct unless something else shares the engine.
NINFER_MAX_CONCURRENCY=1

# Output budget for requests that do not set one. Compose falls back to 8192 if
# this is unset; the origin host serves 32768.
NINFER_DEFAULT_MAX_TOKENS=32768

# Default cap on model reasoning per request. At the cap the engine closes thinking and
# generation continues into content or tool calls. Healthy origin-host requests: p99 16,357
# completion tokens, so 20000 only stops spirals. Keep it well below the output budget.
NINFER_THINKING_BUDGET=20000

# ── Tuning (measured on the origin host — re-sweep after any artifact or GPU
#    change with bench/bench.sh; draft-token optima do NOT transfer) ──────────

# Speculative decoding draft tokens. MTP is the backend here; DFlash2 needs companion
# weights this deployment does not have. Origin-host optima: nvfp4 → 4; groupwise → 2..4
# (flat, 5 collapses acceptance). Capped at 5 for MTP.
NINFER_DRAFT_TOKENS=4

# KV cache dtype. int8 (group-64) measured zero throughput cost vs bf16 and
# halves KV VRAM — it is what makes large context affordable.
NINFER_KV_DTYPE=int8
